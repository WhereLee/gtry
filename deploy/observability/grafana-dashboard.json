{
  "title": "Helpdesk",
  "uid": "helpdesk",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"}]
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "jvm_memory_used_bytes{area=\"heap\"}"}]
    },
    {
      "type": "timeseries",
      "title": "AI stream result",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(helpdesk_ai_stream_total[5m])) by (result)"}]
    },
    {
      "type": "timeseries",
      "title": "LLM fallback / SLA breaches",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "increase(helpdesk_llm_fallback_total[5m])"},
        {"expr": "increase(helpdesk_sla_breaches_total[5m])"}
      ]
    }
  ]
}
